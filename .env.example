# Copy to .env for local development. Do not commit .env.
# All values shown here are safe placeholders, not real secrets.

# Which config class create_app() loads. One of: development, testing, production.
FLASK_CONFIG=development

# Required in production. Dev has a built-in fallback; production refuses to boot without this.
SECRET_KEY=

# SQLAlchemy connection string.
#   dev   - sqlite:///instance/uma_ladder.dev.sqlite
#   test  - sqlite:///:memory: (set by TestConfig, do not override here)
#   prod  - postgresql+psycopg://user:pass@host:5432/uma_ladder
DATABASE_URL=

# Discord webhook URLs. Leave blank to disable each channel. Never commit real URLs.
DISCORD_WEBHOOK_RACE_REGISTRATION_URL=
DISCORD_WEBHOOK_OFFICIAL_RESULTS_URL=
DISCORD_WEBHOOK_DRAFT_RESULTS_URL=
# Admin / moderation audit feed — every privileged action is mirrored
# here in real time (role changes, race/match cancellations, forfeits).
# Point this at a private mod channel.
DISCORD_WEBHOOK_ADMIN_AUDIT_URL=
DISCORD_WEBHOOK_FALLBACK_URL=

# OCR provider for race-result screenshots.
#   manual         - default; returns an empty parse so the human types it in.
#   mock           - deterministic fixture data; useful for local UI dev.
#   google_vision  - Google Cloud Vision DOCUMENT_TEXT_DETECTION
#                    (free for first 1000 images / month, then $1.50/1000).
OCR_PROVIDER=manual

# Required when OCR_PROVIDER=google_vision. Use an API key (not a service
# account JSON) so deployment stays a single env var. Restrict the key to
# the Vision API + your server's IP in the GCP console.
GOOGLE_VISION_API_KEY=

# Set to 1 after `make tailwind` has produced uma_ladder/static/css/output.css.
# Prod defaults to 1 (assumes the build ran during deploy); dev defaults to 0
# so base.html falls back to cdn.tailwindcss.com and you don't need to rebuild
# CSS on every reload. Override only if you've changed the deploy convention.
TAILWIND_BUILT=

# Public base URL for outgoing Discord embed links — set to your
# production hostname so notification titles link back to the race
# detail page. No trailing slash. Leave blank in dev to disable.
#   prod: https://umaladder.moe
APP_BASE_URL=

